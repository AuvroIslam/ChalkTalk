# Copy to .env and fill in. Never commit .env.

OPENAI_API_KEY=sk-...
# Optional: use an Azure OpenAI deployment in Microsoft Foundry instead of api.openai.com
# OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1/
# (then OPENAI_API_KEY is the Azure key and CHALK_MODEL is your deployment name)

CHALK_MODEL=gpt-5-mini
# none / minimal / low / medium - lower draws sooner. Empty for non-reasoning models (gpt-4.1...).
CHALK_REASONING=minimal
# How hard it thinks for walkthroughs (Dijkstra...) and screens filled by a drawing: accuracy over speed.
CHALK_DRAW_REASONING=medium

# Stronger model, if your Foundry subscription has no quota for one: use OpenAI directly.
# Leave AZURE_OPENAI_ENDPOINT empty, set OPENAI_API_KEY, and:
#   CHALK_MODEL=gpt-5.5
#   CHALK_REASONING=low
#   CHALK_CHECK_REASONING=low
# (gpt-5.5 doesn't accept "minimal". Measured on the force diagram: every number on the right arrow.)
# Max rounds of "read more context" before it must answer
CHALK_MAX_TOOL_ROUNDS=3

# Web search + reading full web pages (https://firecrawl.dev). Also read from ../.env as fireCrawl_api.
# FIRECRAWL_API_KEY=fc-...

# Teaching voice: each step is spoken, and drawing waits for it (Windows voices: Zira, David, Mark)
CHALK_VOICE_OUT=1
CHALK_VOICE_NAME=Zira
CHALK_VOICE_RATE=1.1
# 1.0 = quick; 0.5 = like a hand writing on a board
CHALK_DRAW_SPEED=0.5

CHALK_HOTKEY=ctrl+shift+space
# Press and just talk (captures the screen and listens)
CHALK_VOICE_HOTKEY=ctrl+g

# Voice: speech-to-text deployment on Microsoft Foundry (e.g. gpt-4o-mini-transcribe)
# CHALK_STT_ENDPOINT=https://YOUR-VOICE-RESOURCE.openai.azure.com/openai/v1/
# CHALK_STT_KEY=...
# CHALK_STT_MODEL=gpt-4o-mini-transcribe
CHALK_FONT=Segoe Print
CHALK_FONT_PX=18
fireCrawl_api=
